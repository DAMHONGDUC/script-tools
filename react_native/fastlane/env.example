# Copy to ios/fastlane/.env (git ignores it) and fill in.

# Apple Developer team id (10 characters), from developer.apple.com → Membership.
IOS_TEAM_ID=

# App Store Connect API key with the App Manager role, from
# App Store Connect → Users and Access → Integrations → App Store Connect API.
ASC_KEY_ID=
ASC_ISSUER_ID=
# The downloaded AuthKey_<id>.p8, relative to ios/fastlane/ or absolute.
# Keep it out of git; ios/fastlane/*.p8 is ignored.
ASC_KEY_FILEPATH=AuthKey.p8
# Or, instead of the file (CI): the .p8 content, base64 encoded.
# ASC_KEY_CONTENT=
